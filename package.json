{
  "name": "mindulle-design-system",
  "private": true,
  "description": "Mindulle Design System (MDS v0.1.0) — Core UI & Tokens (powered by Sonagi Engine)",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "build:fix": "python3 scripts/fix-build.py",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "prepare": "husky",
    "tokens:sync": "python3 scripts/fix-tokens.py",
    "blog:refactor": "python3 scripts/refactor_blog_ui.py",
    "script:test-fetch": "node scripts/test-fetch.mjs",
    "lint:tokens": "eslint apps/docs packages/ui --no-inline-config --pass-on-unpruned-suppressions",
    "tokens:map": "python3 scripts/token-map.py"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "^9.39.5",
    "eslint-plugin-tailwindcss": "4.4.1-beta.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.8.4",
    "turbo": "^2.5.4",
    "typescript-eslint": "^8.73.0"
  },
  "lint-staged": {
    "packages/tokens/tokens/**/*.json": [
      "pnpm --filter @mindulle/tokens build"
    ],
    "**/*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
