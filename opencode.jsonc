{
  "$schema": "https://opencode.ai/config.json",
  // figma-console MCP는 전역(~/.config/opencode/opencode.jsonc)에서 비활성화되어 있다.
  // 이 서버는 9223-9232 (10칸) 포트 범위를 쓰고, 프로젝트 디렉터리마다 프로세스가
  // 하나씩 뜨기 때문에 활성 프로젝트를 늘리면 포트가 고갈된다
  // (증상: EADDRINUSE / "All ports in range exhausted").
  // Figma 작업이 필요한 프로젝트에서만 이 블록을 복사해서 켠다.
  "mcp": {
    "figma-console": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "FIGMA_WS_HOST=0.0.0.0 FIGMA_ACCESS_TOKEN={file:~/.secrets/figma-pat} ENABLE_MCP_APPS=true node /home/ubuntu/MCPs/figma-console-mcp/node_modules/figma-console-mcp/dist/local.js"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "{file:~/.secrets/figma-pat}",
        "FIGMA_WS_HOST": "0.0.0.0",
        "ENABLE_MCP_APPS": "true"
      },
      "enabled": true
    }
  }
}
