{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "MDS Spacing Semantics",
    "description": "Semantic spacing roles. Values alias the numeric spacing scale in primitives.json."
  },
  "space": {
    "gap": {
      "xs": {
        "$value": "{spacing.1}",
        "$type": "dimension"
      },
      "sm": {
        "$value": "{spacing.2}",
        "$type": "dimension"
      },
      "item": {
        "$value": "{spacing.4}",
        "$type": "dimension"
      },
      "group": {
        "$value": "{spacing.6}",
        "$type": "dimension"
      },
      "section": {
        "$value": "{spacing.8}",
        "$type": "dimension"
      }
    },
    "container": {
      "sm": {
        "$value": "{spacing.3}",
        "$type": "dimension"
      },
      "md": {
        "$value": "{spacing.4}",
        "$type": "dimension"
      },
      "lg": {
        "$value": "{spacing.6}",
        "$type": "dimension"
      },
      "page": {
        "$value": "{spacing.8}",
        "$type": "dimension"
      }
    },
    "element": {
      "py": {
        "$value": "{spacing.2}",
        "$type": "dimension"
      },
      "px": {
        "$value": "{spacing.4}",
        "$type": "dimension"
      }
    }
  }
}
