            "base": {
              "$value": "{primitive.paper.50}",
              "$type": "color"
            },
            "surface": {
              "$value": "{primitive.paper.50}",
              "$type": "color"
            },
            "elevated": {
              "$value": "{primitive.paper.50}",
              "$type": "color"
            }
          },
          "text": {
            "primary": {
              "$value": "{primitive.ink.900}",
              "$type": "color"
            },
            "secondary": {
              "$value": "{primitive.ink.600}",
              "$type": "color"
            },
            "muted": {
              "$value": "{primitive.ink.600}",
              "$type": "color"
            },
            "disabled": {
              "$value": "{primitive.ink.200}",
              "$type": "color"
            },
            "inverse": {
