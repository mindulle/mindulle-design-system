            "accent": {
              "$value": "{primitive.spot.600}",
              "$type": "color"
            },
            "accent-hover": {
              "$value": "{primitive.spot.700}",
              "$type": "color"
            }
          }
        }
      },
      "dark": {
        "color": {
          "background": {
            "base": {
              "$value": "{primitive.paper.950}",
              "$type": "color"
