{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "MDS Surface Scopes",
    "description": "Scoped semantic remaps. Apply data-surface=\"<name>\" to swap surface values without introducing parallel token names."
  },
  "surface": {
